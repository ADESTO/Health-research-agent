# Copy to .env and fill in.

# --- Database (docker compose exposes Postgres on 5432) ---
DATABASE_URL=postgresql://research:research@localhost:5432/research

# --- Data source ---
# Stream straight from Hugging Face (no download needed; DuckDB fetches only what it needs):
METADATA_GLOB=hf://datasets/secemp9/arxiv-complete/metadata/*.parquet
PAPER_TEXT_GLOB=hf://datasets/secemp9/arxiv-complete/paper_text/*.parquet
# ...or download the 1.6 GB metadata config once and point at it (faster, repeatable):
#   huggingface-cli download secemp9/arxiv-complete --repo-type dataset --include "metadata/*" --local-dir data/arxiv
# METADATA_GLOB=data/arxiv/metadata/*.parquet
MIN_YEAR=2010

# --- Embeddings ---
EMBEDDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- LLM provider seam: anthropic | groq | deepseek ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: a stronger model just for the orchestrator + synthesis agents
ANTHROPIC_MODEL_STRONG=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional stronger model for the orchestrator + synthesis agents, e.g. deepseek-v4-pro
DEEPSEEK_MODEL_STRONG=
# disabled (default: faster, cheaper for tool-heavy agents) | enabled
DEEPSEEK_THINKING=disabled

# --- PubMed Central (optional second corpus: python -m research_agent.cli pmc-ingest "topic") ---
# Free key from https://account.ncbi.nlm.nih.gov/settings/ raises the rate limit from 3 to 10 req/s
NCBI_API_KEY=
PMC_EMAIL=
# --- Cost guards per run ---
MAX_SHORTLIST=60
MAX_FULLTEXT=20
EXTRACTION_WORKERS=4

# --- Groq free tier profile (8K tokens/minute, 200K tokens/day on gpt-oss-120b) ---
# Uncomment these to fit each request under the per-minute limit. Expect a run to take 20-40 min
# (it waits out rate limits) and roughly one full run per day within the daily token cap.
# AGENT_MAX_TOKENS=1200
# REPORT_MAX_TOKENS=2500
# EXTRACTION_MAX_TOKENS=1200
# TOOL_RESULT_CHARS=3500
# CONTEXT_BUDGET_CHARS=12000
# MAX_SHORTLIST=12
# MAX_FULLTEXT=2
# EXTRACTION_WORKERS=1
# Preview models such as qwen/qwen3.8-27b also cap OUTPUT tokens per minute (1,000 when tested):
# keep AGENT_MAX_TOKENS, EXTRACTION_MAX_TOKENS and REPORT_MAX_TOKENS at 900 or below for those.
