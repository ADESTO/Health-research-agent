# Copy to .env and fill in.

# --- Database (docker compose exposes Postgres on 5432) ---
DATABASE_URL=postgresql://research:research@localhost:5432/research

# --- Data source ---
# Stream straight from Hugging Face (no download needed; DuckDB fetches only what it needs):
METADATA_GLOB=hf://datasets/secemp9/arxiv-complete/metadata/*.parquet
PAPER_TEXT_GLOB=hf://datasets/secemp9/arxiv-complete/paper_text/*.parquet
# ...or download the 1.6 GB metadata config once and point at it (faster, repeatable):
#   huggingface-cli download secemp9/arxiv-complete --repo-type dataset --include "metadata/*" --local-dir data/arxiv
# METADATA_GLOB=data/arxiv/metadata/*.parquet
MIN_YEAR=2010

# --- Embeddings ---
EMBEDDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- LLM provider seam: anthropic | groq ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: a stronger model just for the orchestrator + synthesis agents
ANTHROPIC_MODEL_STRONG=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Cost guards per run ---
MAX_SHORTLIST=60
MAX_FULLTEXT=20
EXTRACTION_WORKERS=4
